# Claude Viewer Server Configuration

# Path to Claude Code projects directory
# Default: ~/.claude/projects (will auto-expand ~ to home directory)
# You can also use absolute paths like /home/username/.claude/projects
PROJECT_ROOT=~/.claude/projects

# Server port
PORT=3400

# Environment (development or production)
NODE_ENV=development

# Optional: Custom search database path (defaults to ./data/search.db)
# SEARCH_DB_PATH=./data/search.db