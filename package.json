{
  "name": "claudex",
  "version": "1.1.1",
  "description": "Professional conversation viewer and analysis tool for Claude Code. Search, analyze, and export your AI conversations with enterprise-grade full-text search and multi-platform support.",
  "main": "index.js",
  "bin": {
    "claudex": "./bin/claude-viewer.js"
  },
  "files": [
    "bin/",
    "server/src/",
    "server/package.json",
    "server/.env.example",
    "client/dist/",
    "client/index.html",
    "client/package.json",
    "client/vite.config.js",
    "scripts/check-system.mjs",
    "scripts/postinstall.js",
    "LICENSE",
    "README.md",
    "quick-start.sh"
  ],
  "preferGlobal": true,
  "scripts": {
    "start": "node bin/claude-viewer.js",
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "install-deps": "npm install --prefix server && npm install --prefix client",
    "postinstall": "node scripts/postinstall.js",
    "prepublishOnly": "npm run build && npm test",
    "test": "npm test --prefix server && npm test --prefix client",
    "check": "node scripts/check-system.mjs",
    "check:verbose": "node scripts/check-system.mjs --verbose",
    "check:fix": "node scripts/check-system.mjs --fix",
    "check:json": "node scripts/check-system.mjs --json",
    "predev": "node scripts/check-system.mjs --quiet || true"
  },
  "keywords": [
    "claude",
    "claude-code",
    "conversation-viewer",
    "ai-tools",
    "anthropic",
    "jsonl",
    "full-text-search",
    "react",
    "fastify",
    "sqlite",
    "fts5",
    "developer-tools",
    "conversation-analysis",
    "usage-monitoring"
  ],
  "author": "Kunwar Shah <kunwar@example.com>",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "concurrently": "^8.2.0",
    "cross-spawn": "^7.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kunwar-shah/claudex.git"
  },
  "bugs": {
    "url": "https://github.com/kunwar-shah/claudex/issues"
  },
  "homepage": "https://kunwar-shah.github.io/claudex/",
  "devDependencies": {
    "playwright": "^1.55.1"
  }
}
